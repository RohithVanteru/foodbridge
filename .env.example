# Copy to .env, replace every placeholder, and never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# For Docker Compose. For local npm development change db to localhost.
DATABASE_URL=postgresql://foodbridge:replace-with-a-long-random-password@db:5432/foodbridge
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
SMTP_HOST=your-smtp-provider
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
MAIL_FROM=FoodBridge <no-reply@example.org>
# Optional: both values required to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# These verified email identities receive administrator access at onboarding.
FOODBRIDGE_ADMIN_EMAILS=owner@example.org
SERVICE_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=/app/data/uploads
CRON_SECRET=replace-with-another-long-random-secret
# Optional browser push: generate once with `npx web-push generate-vapid-keys`.
# Keep the private key secret; preserve this key pair between deploys.
VAPID_SUBJECT=mailto:operations@example.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
